{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.example/schemas/exception.schema.json",
  "title": "Axiom Exception",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "axiom.io/v1"
    },
    "kind": {
      "const": "Exception"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "owners"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "status",
        "targets",
        "scope",
        "rationale",
        "startsAt",
        "expiresAt",
        "approvers"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "expired"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "organizations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "systems": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "repositories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "apis": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "technologies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "environments": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "changeClasses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trackingIssue": {
          "type": "string"
        },
        "compensatingControls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "supersedes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "supersededBy": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "refines": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "implements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "conflictsWith": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "related": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "motivatedBy": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exceptionTo": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
