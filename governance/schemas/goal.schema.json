{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.example/schemas/goal.schema.json",
  "title": "Axiom Goal",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "axiom.io/v1"
    },
    "kind": {
      "const": "Goal"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "owners"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "status",
        "scope",
        "authority",
        "enforcement",
        "statement"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "deprecated",
            "superseded",
            "rejected"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "organizations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "systems": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "repositories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "apis": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "technologies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "environments": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "changeClasses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "authority": {
          "type": "object",
          "required": [
            "level",
            "exemptable"
          ],
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "regulatory-security-hard",
                "organization",
                "domain",
                "system",
                "component",
                "repository",
                "advisory"
              ]
            },
            "exemptable": {
              "type": "boolean"
            }
          }
        },
        "enforcement": {
          "type": "object",
          "required": [
            "defaultVerdict"
          ],
          "additionalProperties": false,
          "properties": {
            "defaultVerdict": {
              "enum": [
                "info",
                "warn",
                "require_review",
                "block"
              ]
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "ruleId",
                  "mode"
                ],
                "additionalProperties": false,
                "properties": {
                  "ruleId": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "mode": {
                    "enum": [
                      "info",
                      "warn",
                      "require_review",
                      "block"
                    ]
                  },
                  "with": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preferred": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "supersedes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "supersededBy": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "refines": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "implements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "conflictsWith": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "related": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "motivatedBy": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exceptionTo": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "effectiveFrom": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "effectiveUntil": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "reviewAfter": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "governsExistingCode": {
          "type": "boolean"
        },
        "migration": {
          "enum": [
            "immediate",
            "new-code-only",
            "phased",
            "date-bound"
          ]
        },
        "semanticExternalAllowed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "excerptHash",
              "method",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "excerptHash": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "suggestedOwner": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
