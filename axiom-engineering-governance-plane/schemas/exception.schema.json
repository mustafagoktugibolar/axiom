{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.example/schemas/exception.schema.json",
  "title": "Axiom Exception",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "schemaVersion": {
      "const": "axiom.io/v1"
    },
    "kind": {
      "const": "Exception"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "owners"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "status",
        "targets",
        "scope",
        "rationale",
        "startsAt",
        "expiresAt",
        "approvers"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "expired"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "object"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "trackingIssue": {
          "type": "string"
        },
        "compensatingControls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
