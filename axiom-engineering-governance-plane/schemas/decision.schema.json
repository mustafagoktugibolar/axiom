{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.example/schemas/decision.schema.json",
  "title": "Axiom Decision",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "schemaVersion": {
      "const": "axiom.io/v1"
    },
    "kind": {
      "const": "Decision"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "owners"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "status",
        "scope",
        "authority",
        "enforcement",
        "decision"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "deprecated",
            "superseded",
            "rejected"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "authority": {
          "type": "object",
          "required": [
            "level",
            "exemptable"
          ],
          "properties": {
            "level": {
              "enum": [
                "regulatory-security-hard",
                "organization",
                "domain",
                "system",
                "component",
                "repository",
                "advisory"
              ]
            },
            "exemptable": {
              "type": "boolean"
            }
          }
        },
        "enforcement": {
          "type": "object",
          "required": [
            "defaultVerdict"
          ],
          "properties": {
            "defaultVerdict": {
              "enum": [
                "info",
                "warn",
                "require_review",
                "block"
              ]
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationships": {
          "type": "object"
        },
        "validity": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "properties": {
        "organizations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changeClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
